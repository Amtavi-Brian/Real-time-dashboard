APP_NAME=Columbus HR Time & Wage Analytics API
ENVIRONMENT=development

# SQLite by default for zero-setup local development. Point this at PostgreSQL
# for staging/production, e.g.:
# DATABASE_URL=postgresql+psycopg://columbus:columbus@localhost:5432/columbus_hr
DATABASE_URL=sqlite:///./columbus_hr.db

SECRET_KEY=columbus-dev-secret-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

WS_BROADCAST_INTERVAL_SECONDS=12
